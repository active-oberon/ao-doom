MODULE DoomKeys;
IMPORT DoomConfig;

(* The YAML stores Inputs/X11 key symbols on every platform. Polling also supports
   SDK drivers that suppress releases; it does not depend on the keyboard layout. *)
PROCEDURE VirtualKey*(key: SIGNED32): SIGNED32;
BEGIN
	key := DoomConfig.KeySymbol(key);
	IF (key >= ORD("a")) & (key <= ORD("z")) THEN RETURN key - 32 END;
	IF (key >= ORD("0")) & (key <= ORD("9")) OR (key = 32) THEN RETURN key END;
	IF (key >= 0FFBEH) & (key <= 0FFD5H) THEN RETURN key - 0FFBEH + 112 END;
	CASE key OF
		0FF08H: RETURN 8 | 0FF09H: RETURN 9 | 0FF0DH, 0FF8DH: RETURN 13
		| 0FF1BH: RETURN 27 | 0FF50H: RETURN 36 | 0FF51H: RETURN 37
		| 0FF52H: RETURN 38 | 0FF53H: RETURN 39 | 0FF54H: RETURN 40
		| 0FF55H: RETURN 33 | 0FF56H: RETURN 34 | 0FF57H: RETURN 35
		| 0FF63H: RETURN 45 | 0FFFFH: RETURN 46
		| 0FFE1H: RETURN 160 | 0FFE2H: RETURN 161 | 0FFE3H: RETURN 162
		| 0FFE4H: RETURN 163 | 0FFE9H: RETURN 164 | 0FFEAH: RETURN 165
		| 0FFEBH: RETURN 91 | 0FFECH: RETURN 92
		| 0FFAAH: RETURN 106 | 0FFABH: RETURN 107 | 0FFADH: RETURN 109
		| 0FFAEH: RETURN 110 | 0FFAFH: RETURN 111
		| 59, 58: RETURN 186 | 61, 43: RETURN 187 | 44, 60: RETURN 188
		| 45, 95: RETURN 189 | 46, 62: RETURN 190 | 47, 63: RETURN 191
		| 96, 126: RETURN 192 | 91, 123: RETURN 219 | 92, 124: RETURN 220
		| 93, 125: RETURN 221 | 39, 34: RETURN 222
	ELSE RETURN 0
	END
END VirtualKey;

END DoomKeys.
